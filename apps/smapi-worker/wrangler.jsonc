{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sonofin-smapi",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  // Preserve dashboard-managed variables such as ONBOARDING_URL on deploy.
  "keep_vars": true,
  "vars": {
    "LINK_CODE_TTL_SECONDS": "600"
  },
  "secrets_store_secrets": [
    {
      "binding": "JELLYFIN_TOKEN_ENCRYPTION_KEY",
      "store_id": "f3ae0e25658946e9bd40dd4693f45341",
      "secret_name": "Sonofin"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sonofin",
      // Wrangler binds the existing database by name or provisions it on deploy.
      "migrations_dir": "../../packages/database/migrations"
    }
  ]
}
