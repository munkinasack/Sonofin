{
  "name": "sonofin",
  "version": "0.0.0",
  "description": "A Cloudflare Workers Sonos Music API service for Jellyfin.",
  "private": true,
  "license": "UNLICENSED",
  "homepage": "https://github.com/munkinasack/Sonofin#readme",
  "bugs": {
    "url": "https://github.com/munkinasack/Sonofin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munkinasack/Sonofin.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter './apps/*' build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:d1 && pnpm build",
    "db:migrate:local": "wrangler d1 migrations apply sonofin --local --persist-to .wrangler/state --config apps/smapi-worker/wrangler.jsonc",
    "dev": "pnpm dev:smapi",
    "dev:auth": "wrangler dev --config apps/auth-worker/wrangler.jsonc --port 8788 --persist-to .wrangler/state",
    "dev:smapi": "wrangler dev --config apps/smapi-worker/wrangler.jsonc --port 8787 --persist-to .wrangler/state",
    "lint": "eslint .",
    "test": "vitest run",
    "test:d1": "vitest run --config vitest.d1.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260820.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
